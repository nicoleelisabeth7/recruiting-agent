# Slack Bot Configuration
# Get these from your Slack App settings > OAuth & Permissions

# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-token-here

# App Signing Secret (from Basic Information)
SLACK_SIGNING_SECRET=your-signing-secret-here

# (Optional) Incoming Webhook URL if using webhook instead of bot token for posting
# Get from Incoming Webhooks integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Cloudflare Worker Settings
LOG_LEVEL=debug
